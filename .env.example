# ==============================================================================
# PAKDEEPAN SCHOOL WEBSITE (โรงเรียนภักดีพรรณ) — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local (development) or configure in Vercel Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (PostgreSQL - Neon / Supabase / AWS RDS)
# ------------------------------------------------------------------------------
# Neon Serverless Postgres (Singapore ap-southeast-1 region recommended for Thailand)
# Use the pooled connection string (port 5432 or pgbouncer) for Next.js web traffic:
DATABASE_URL="postgresql://neondb_owner:your-password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Unpooled string for schema migrations and direct DDL commands:
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:your-password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URI="postgresql://neondb_owner:your-password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. PAYLOAD CMS SECURITY & ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong 32+ character random secret used for JWT signing and cookie encryption.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET="your-strong-production-payload-secret-key-min-32-chars"

# ------------------------------------------------------------------------------
# 3. SITE URL & HOST DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical production URL (used for SEO metadataBase, sitemap.xml, robots.txt, and OpenGraph cards on LINE / Facebook).
NEXT_PUBLIC_SITE_URL="https://pakdeepan.ac.th"
NEXT_PUBLIC_SERVER_URL="https://pakdeepan.ac.th"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 STORAGE (TIER 1 PRIMARY — ZERO EGRESS FEES FOR UNLIMITED MEDIA)
# ------------------------------------------------------------------------------
# Create a bucket in Cloudflare Dashboard: R2 > Create Bucket (e.g., 'pakdeepan-media')
# Manage R2 API Tokens: R2 > Manage R2 API Tokens > Create API Token (Admin Read & Write)
R2_ACCOUNT_ID="your-cloudflare-account-id-32-hex-chars"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key-64-hex-chars"
R2_BUCKET="pakdeepan-media"
R2_BUCKET_NAME="pakdeepan-media"
# Public CDN URL for serving images (Custom Domain or pub-xxxx.r2.dev):
R2_PUBLIC_URL="https://media.pakdeepan.ac.th"
# Optional direct S3 endpoint (defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com):
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"

# ------------------------------------------------------------------------------
# 5. VERCEL BLOB STORAGE (TIER 2 FALLBACK)
# ------------------------------------------------------------------------------
# Automatically injected by Vercel when connecting Vercel Blob in project dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 6. SUPABASE STORAGE (TIER 3 FALLBACK)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# 7. LOCALIZATION & SYSTEM DEFAULTS
# ------------------------------------------------------------------------------
# Default language: 'th' for Thai-first, 'en' for English
NEXT_LOCALE="th"
